    "margin_vine = []\n",
    "for i in range(0,vine_depth,1):\n",
    "    mar_p = margin_obj('norm', [0,1], True)\n",
    "    margin_vine.append(mar_p)\n",
    "    \n",
    "vine = vine_obj_bin(vine_type, families, vine_depth, margin_vine, knots, method, r_matrix)\n",
